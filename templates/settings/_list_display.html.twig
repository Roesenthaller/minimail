{#
settings/_list_display.html.twig
─────────────────────────────────────────────────────────────────────────────
How a list row looks, for this reader: the size of the sender disc, the colours
it is drawn in, and the width of the sender column. Saved as each is picked by
`settings--list-display`, which also sets the matching attribute on <html> so
the strip below follows at once. See ListDisplay for the allowed values and
app.css for what each does.

Accepts:
  avatar_size    string  small | medium | large
  avatar_scheme  string  muted | soft | neutral
  sender_width   string  normal | wide | wider
  inbox_as_messages  bool  whether the Inbox opens as one row per email
#}
{% set segText = 'flex h-full items-center justify-center px-3 py-1.5 text-center text-[11px] leading-tight text-ink-muted
                  peer-checked:bg-accent peer-checked:text-accent-ink
                  peer-focus-visible:ring-2 peer-focus-visible:ring-inset peer-focus-visible:ring-accent
                  transition-colors cursor-pointer' %}
{% set groups = [
    { field: 'avatar_size',   attribute: 'data-avatar-size',   current: avatar_size,   values: ['small', 'medium', 'large'] },
    { field: 'avatar_scheme', attribute: 'data-avatar-scheme', current: avatar_scheme, values: ['letter', 'muted', 'soft', 'neutral'] },
    { field: 'sender_width',  attribute: 'data-sender-width',  current: sender_width,  values: ['normal', 'wide', 'wider'] },
] %}

<div class="divide-y divide-line"
     data-controller="settings--list-display"
     data-settings--list-display-url-value="{{ path('app_appearance_list_display_state') }}"
     data-settings--list-display-token-value="{{ csrf_token('list_display_state') }}">
    <label class="px-4 py-3 flex items-start justify-between gap-3 cursor-pointer">
        <span class="min-w-0">
            <span class="block text-xs font-medium text-ink-muted">{{ 'settings.list_display.inbox_as_messages.label'|trans }}</span>
            <span class="block text-[11px] text-ink-faint mt-0.5">{{ 'settings.list_display.inbox_as_messages.hint'|trans }}</span>
        </span>
        <input type="checkbox" name="inbox_as_messages" class="mt-0.5 h-4 w-4 shrink-0 accent-[var(--color-accent,currentColor)]"
               data-action="change->settings--list-display#toggle"
               {{ inbox_as_messages|default(false) ? 'checked' : '' }}>
    </label>

    {% for group in groups %}
        <div class="px-4 py-3 flex items-start justify-between gap-3">
            <span class="min-w-0">
                <span class="block text-xs font-medium text-ink-muted" id="list-display-{{ group.field }}">{{ ('settings.list_display.' ~ group.field ~ '.label')|trans }}</span>
                <span class="block text-[11px] text-ink-faint mt-0.5">{{ ('settings.list_display.' ~ group.field ~ '.hint')|trans }}</span>
            </span>

            <div class="grid grid-flow-col auto-cols-fr shrink-0 rounded-pane border border-line overflow-hidden"
                 role="radiogroup" aria-labelledby="list-display-{{ group.field }}"
                 data-saved="{{ group.current }}">
                {% for value in group.values %}
                    <label>
                        <input type="radio" name="{{ group.field }}" class="peer sr-only"
                               value="{{ value }}"
                               data-field="{{ group.field }}"
                               data-attribute="{{ group.attribute }}"
                               data-action="change->settings--list-display#pick"
                               aria-label="{{ ('settings.list_display.' ~ group.field ~ '.' ~ value)|trans }}"
                               {{ group.current == value ? 'checked' : '' }}>
                        <span class="{{ segText }}">{{ ('settings.list_display.' ~ group.field ~ '.' ~ value)|trans }}</span>
                    </label>
                {% endfor %}
            </div>
        </div>
    {% endfor %}

    <div class="px-4 py-3">
        <span class="block text-[11px] text-ink-faint mb-2">{{ 'settings.list_display.preview'|trans }}</span>
        <div class="flex items-center gap-3">
            {% for name in ['Ada Lovelace', 'Ben Carter', 'Chloe Diaz', 'Dev Patel', 'Eva Novak', 'Finn Olsen', 'Grace Kim', 'Hugo Weiss', 'Ivy Chen', 'Jon Reid', 'Kai Ortiz', 'Lena Roth'] %}
                <span data-row-avatar-face data-tone="{{ name|avatar_tone_index }}" data-letter="{{ name|avatar_letter_index }}"
                      class="relative flex items-center justify-center rounded-full w-[var(--avatar-size,1.75rem)] h-[var(--avatar-size,1.75rem)] text-xs font-semibold select-none {{ name|avatar_tone }}"
                      aria-hidden="true">{{ name|avatar_initial(name) }}</span>
            {% endfor %}
        </div>
    </div>
</div>
